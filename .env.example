MYCANCERTEAM_ENVIRONMENT=dev
MYCANCERTEAM_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
MYCANCERTEAM_AZURE_OPENAI_DEPLOYMENT=<your-deployment>

# Local working root (everything below lives here unless overridden).
MYCANCERTEAM_LOCAL_WORKING_FOLDER=.local

# Clinical notes: source of truth from the in-person team (imaging, reports, prescriptions/plans).
MYCANCERTEAM_CLINICAL_NOTES_FOLDER=.local/clinical-notes
MYCANCERTEAM_CLINICAL_IMAGING_FOLDER=.local/clinical-notes/imaging
MYCANCERTEAM_CLINICAL_REPORTS_FOLDER=.local/clinical-notes/reports
MYCANCERTEAM_CLINICAL_PLANS_FOLDER=.local/clinical-notes/plans

# Non-clinical: administrative / financial documents (insurance, etc.).
MYCANCERTEAM_NON_CLINICAL_FOLDER=.local/non-clinical
MYCANCERTEAM_NON_CLINICAL_INSURANCE_FOLDER=.local/non-clinical/insurance

# Research: AI / web-sourced material.
MYCANCERTEAM_RESEARCH_FOLDER=.local/research
MYCANCERTEAM_RESEARCH_CACHE_FOLDER=.local/research/cache
MYCANCERTEAM_RESEARCH_SUMMARIES_FOLDER=.local/research/summaries
MYCANCERTEAM_RESEARCH_GLOBAL_TREATMENT_SEARCH_FOLDER=.local/research/global-treatment-search
MYCANCERTEAM_RESEARCH_INTL_SECOND_OPINIONS_FOLDER=.local/research/international-second-opinions

# Operational.
MYCANCERTEAM_DRAFTS_FOLDER=.local/drafts
MYCANCERTEAM_AGENT_MEMORY_FOLDER=.local/agent-memory
MYCANCERTEAM_ITERATIONS_FOLDER=.local/iterations

# Outputs: tracking log (append-only) and final case summary (regenerated each run).
MYCANCERTEAM_LATEST_SHARED_NOTES_PATH=.local/notes/notes.md
MYCANCERTEAM_CASE_SUMMARY_PATH=.local/case-summary.md

MYCANCERTEAM_DAILY_RESEARCH_REFRESH_SCHEDULE=0 8 * * *
